# The dashboard app (frontend/) had no ignore file of its own, so `git add -A`
# from the repo root would happily stage node_modules/ and dist/. The nested
# app (pudo-accra/) ships its own; this covers this one.

node_modules
dist
dist-ssr
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local env overrides — .env.example is the committed template.
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
